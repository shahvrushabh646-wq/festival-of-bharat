# Optional live public YouTube Shorts research metrics
YOUTUBE_API_KEY=

# Optional dynamic public Instagram Reel URL discovery through Google Custom Search JSON API
# Without both values, use the public Google search links in the app.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional local FFmpeg background worker; install both tools and point to executable paths if not on PATH
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_PRESET=veryfast
FFMPEG_FONT_FILE=
# FOB_* names are preferred; FFMPEG_PATH/FFPROBE_PATH remain supported.
FOB_FFMPEG_PATH=
FOB_FFPROBE_PATH=

# Optional local render window. This schedules only jobs already researched,
# sourced, rights-checked, and queued in the studio. It does not research offline.
FOB_SCHEDULE_ENABLED=false
FOB_START_TIME=02:00
FOB_END_TIME=06:00
FOB_DAILY_REEL_COUNT=4

# Optional hosted scene analysis; selected images/video frames are sent to OpenAI when enabled
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini

# Authorized Instagram Login / own-account Insights (Creator or Business only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8766/api/instagram/callback
META_GRAPH_VERSION=v25.0
